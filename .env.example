# =============================================================================
# ChannelHunter — configuration reference
# =============================================================================
# Copy to .env and fill in the secrets:
#   cp .env.example .env
#
# Rules:
#   * .env is git-ignored; never commit real secrets.
#   * Real environment variables always win over this file.
#   * Every value has a documented default (see internal/config/config.go).
#   * Production values that are unsafe (polling mode, short JWT secret) are
#     rejected at startup on purpose.
# =============================================================================

# --- General ----------------------------------------------------------------
# development | staging | production
APP_ENV=development
# Public base URL of the API (used in links and reports).
PUBLIC_BASE_URL=http://localhost:8080
# Timezone used for daily aggregation boundaries and report periods.
APP_TIMEZONE=Europe/Moscow
# ISO-4217 currency for plan prices.
BILLING_CURRENCY=RUB
# Maximum size of an uploaded CSV/XLSX file, in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760
# Hard timeout for a single outbound provider request.
PROVIDER_TIMEOUT=20s

# --- HTTP API ---------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Must be >= 6s: net/http treats brand-new connections as busy for 5s.
HTTP_SHUTDOWN_TIMEOUT=20s
# Comma-separated CIDRs of proxies whose X-Forwarded-For is trusted.
# Leave empty when the API is exposed directly (headers are then ignored).
HTTP_TRUSTED_PROXIES=
# Comma-separated origins allowed to call the API from a browser.
# The Mini App is served same-origin and needs no entry here.
HTTP_CORS_ALLOWED_ORIGINS=

# --- PostgreSQL -------------------------------------------------------------
# Inside docker compose the host is "postgres"; locally it is usually 127.0.0.1.
DATABASE_URL=postgres://channelhunter:channelhunter@127.0.0.1:5432/channelhunter?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTHCHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=10s
# Apply pending migrations during boot (handy locally; in production the
# dedicated `migrate` service owns the schema instead).
DATABASE_MIGRATE_ON_START=false
# Directory with .sql migrations. Empty = use the set embedded in the binary.
DATABASE_MIGRATIONS_PATH=

# Used by deploy/docker-compose.yml to create the database container.
POSTGRES_USER=channelhunter
POSTGRES_PASSWORD=channelhunter
POSTGRES_DB=channelhunter
POSTGRES_PORT=5432

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json (production) | text (local)
LOG_FORMAT=json

# --- Telegram ---------------------------------------------------------------
# Get one from @BotFather: https://core.telegram.org/bots#botfather
# Required by the api (Mini App initData verification) and the bot process.
TELEGRAM_BOT_TOKEN=
# polling (local development only) | webhook (required in production)
TELEGRAM_MODE=polling
# Random string sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
# Required in webhook mode; generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Public HTTPS endpoint that Telegram should call, e.g.
# https://api.example.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Bot username without @ (used for deep links to the Mini App).
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user IDs allowed to use admin commands.
TELEGRAM_ADMIN_IDS=

# --- Authentication ---------------------------------------------------------
# Signs API session tokens. Minimum 32 characters in production.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=24h
# Maximum accepted age of Telegram WebApp initData.
AUTH_INITDATA_TTL=24h

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Requests allowed per window per client.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

# --- External analytics provider (optional) ---------------------------------
# ChannelHunter never invents statistics: without a provider key, only the
# Telegram Bot API (owned channels), CSV/XLSX import and manual entry work.
# See docs/architecture.md → "Data sources".
PROVIDER_API_BASE_URL=
PROVIDER_API_KEY=
